generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PROCESSING
  CONFIRMED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AbandonedCartAlertStatus {
  READY // detected + message text prepared, not sent yet (no WhatsApp API wired up, or auto-send hasn't run)
  SENT  // sent — either by the auto-send function once a provider is configured, or an admin manually clicked "mark as sent" after using the click-to-chat link
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String?
  email               String?   @unique
  password            String?
  phone               String?
  image               String?
  role                Role      @default(CUSTOMER)
  resetToken          String?
  resetTokenExpiresAt DateTime?
  emailVerifiedAt      DateTime?
  emailVerifyToken     String?   // sha256 hash of the emailed token
  emailVerifyExpiresAt DateTime?
  phoneVerifiedAt      DateTime? // set when the phone was proven via OTP
  passwordChangedAt    DateTime? // sessions issued before this are signed out
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders              Order[]
  cart                Cart[]
  wishlist            Wishlist[]
  addresses           Address[]
  reviews             Review[]
  abandonedCartAlerts AbandonedCartAlert[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isDefault])
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  image       String?
  description String?
  showInNav   Boolean    @default(true)
  navOrder    Int        @default(0)
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  productCategories ProductCategory[]
  couponRestrictions CouponCategory[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Product {
  id                  Int           @id @default(autoincrement())
  name                String
  slug                String        @unique
  // Admin-only reference code — helps identify what a customer ordered in
  // Orders/Inventory. Never exposed on customer-facing pages/APIs.
  sku                 String?       @unique
  description         String?
  detailsDescription  String?
  price               Int
  comparePrice        Int?
  images              String[]
  categoryId          Int?
  category            Category?     @relation(fields: [categoryId], references: [id])
  stock               Int           @default(0)
  badge               String?
  customizable        Boolean       @default(false)
  fastDelivery        Boolean       @default(false)
  hasCharm            Boolean       @default(false)
  customizationFields Json?
  specifications      Json?
  previewTemplate     String?
  previewZones        Json?
  availableFonts      String[]      @default([])
  status              ProductStatus @default(ACTIVE)
  tags                String[]
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  orderItems         OrderItem[]
  cartItems          CartItem[]
  wishlist           Wishlist[]
  reviews            Review[]
  stockNotifications StockNotification[]
  productCategories  ProductCategory[]
  variants           ProductVariant[]
  couponRestrictions CouponProduct[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([customizable])
  @@index([badge])
  @@index([stock])
  @@index([deletedAt])
}

model ProductVariant {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupName    String
  optionName   String
  price        Int?
  comparePrice Int?
  stock        Int      @default(0)
  images       String[] @default([])
  sku          String?
  sortOrder    Int      @default(0)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  cartItems  CartItem[]

  @@index([productId])
  @@index([productId, groupName])
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int
  categoryId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id            Int             @id @default(autoincrement())
  cartId        Int
  cart          Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product         @relation(fields: [productId], references: [id])
  variantId     Int?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  quantity      Int             @default(1)
  customization Json?
  createdAt     DateTime        @default(now())

  @@index([cartId])
  @@index([productId])
  @@index([cartId, productId])
}

// One row per "abandoned cart" episode the /api/cron/abandoned-cart-scan
// endpoint detects: a logged-in user's cart sat untouched past the delay
// threshold with a phone number on file. Snapshots the message content at
// detection time (product/price could change later; the message shouldn't).
// createdAt is compared against the cart's latest CartItem.createdAt to
// decide whether a *new* alert is needed after the customer adds more items
// following an earlier alert — see the cron route for that logic.
model AbandonedCartAlert {
  id                Int                       @id @default(autoincrement())
  cartId            Int
  userId            Int
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String // snapshot — the number this was (or will be) sent to
  itemCount         Int
  subtotal          Int // paise, snapshot at detection time
  firstProductName  String
  firstProductImage String?
  messageText       String                    @db.Text
  status            AbandonedCartAlertStatus  @default(READY)
  sentAt            DateTime?
  createdAt         DateTime                  @default(now())

  @@index([cartId])
  @@index([userId])
  @@index([status])
}

// A phone number that asked to stop receiving PROMOTIONAL WhatsApp messages
// (replied STOP/UNSUBSCRIBE/etc, or an admin flagged it by hand). Checked
// before sending anything tagged category:"promotional" in
// src/lib/whatsapp.ts — currently just the abandoned-cart reminder.
// Transactional order-status messages (confirmed/shipped/delivered/etc)
// never check this table and always send regardless — those aren't
// marketing, they're the customer's own order info.
model WhatsAppOptOut {
  id        Int      @id @default(autoincrement())
  phone     String   @unique // bare 10-digit Indian number, digits only — same convention as AbandonedCartAlert.phone / addressSnapshot.phone
  reason    String   @default("customer_reply") // "customer_reply" (they sent STOP) | "manual" (admin flagged by hand)
  createdAt DateTime @default(now())
}

model Order {
  id                Int            @id @default(autoincrement())
  userId            Int?
  user              User?          @relation(fields: [userId], references: [id])
  items             OrderItem[]
  totalAmount       Int
  paymentStatus     PaymentStatus  @default(PENDING)
  deliveryStatus    DeliveryStatus @default(PROCESSING)
  paymentMethod     String?
  addressId         Int?
  address           Address?       @relation(fields: [addressId], references: [id])
  addressSnapshot   Json?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  couponCode        String?
  couponId          Int?
  coupon            Coupon?        @relation(fields: [couponId], references: [id])
  couponDiscount    Int?
  trackingId        String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  notes             String?
  giftNote          String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([paymentStatus, deliveryStatus])
  @@index([razorpayOrderId])
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int
  price         Int
  customization Json?
  variantInfo   Json?

  @@index([orderId])
  @@index([productId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Coupon {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  type       String
  value      Int
  minAmount  Int       @default(0)
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  validFrom  DateTime?
  validTo    DateTime?
  applyTo    String    @default("ALL") // "ALL" | "SPECIFIC_PRODUCTS" | "SPECIFIC_CATEGORIES"
  usageLimit Int?
  usedCount  Int       @default(0)
  orders     Order[]
  products   CouponProduct[]
  categories CouponCategory[]
  createdAt  DateTime  @default(now())

  @@index([code])
  @@index([isActive])
}

model CouponProduct {
  id        Int     @id @default(autoincrement())
  couponId  Int
  productId Int
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([couponId])
  @@index([productId])
}

model CouponCategory {
  id         Int      @id @default(autoincrement())
  couponId   Int
  categoryId Int
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([couponId])
  @@index([categoryId])
}

model Review {
  id        Int          @id @default(autoincrement())
  userId    Int?
  user      User?        @relation(fields: [userId], references: [id])
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  name      String
  rating    Int
  comment   String
  images    String[]
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([productId])
  @@index([status])
  @@index([productId, status])
  @@index([userId])
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?
  image     String
  linkUrl   String?
  position  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([position, isActive])
}

model Setting {
  key   String @id
  value String
}

model StockNotification {
  id         Int       @id @default(autoincrement())
  email      String
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([email, productId])
  @@index([productId])
  @@index([notified])
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String?
  entityId  Int?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  phone     String
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, otp])
  @@index([expiresAt])
}

// ── Charms ───────────────────────────────────────────────────────────────────
model Charm {
  id        Int      @id @default(autoincrement())
  name      String
  number    Int      @unique
  image     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
