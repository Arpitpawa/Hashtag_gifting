# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# raw product photoshoot dump (huge, staging-only, never needs to be in git
# or served by Next — see product-photos-import/ at project root)
/product-photos-import/

# typescript
*.tsbuildinfo
next-env.d.ts

# image-replace script artifacts
/product-photos-enhanced/
/.image-replace-progress.json
/old-product-image-urls.json
/backup-product-images-*.json
/contact-sheets/
/image-order.json
/backup-reorder-*.json
/backup-info-graphics-*.json
/image-order-dairy.json

# editor local history + category backups
/.history/

# huge local-only asset dumps / debug scripts — never belongs in git
*.zip
/dbcheck.js
/backup-categories-*.json
/products-sheet.csv
/backup-products-*.json
/backup-names-*.json
/assets-originals/
