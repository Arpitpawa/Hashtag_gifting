generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum DeliveryStatus {
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String?
  phone     String?
  image     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  cart      Cart[]
  wishlist  Wishlist[]
  addresses Address[]
  reviews   Review[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isDefault])
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  image       String?
  description String?
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

// ── PRODUCT — added previewTemplate + previewZones ──
model Product {
  id                  Int           @id @default(autoincrement())
  name                String
  slug                String        @unique
  description         String?
  price               Int           // paise (Rs. 299 = 29900)
  comparePrice        Int?          // paise
  images              String[]      // Cloudinary URLs
  categoryId          Int?
  category            Category?     @relation(fields: [categoryId], references: [id])
  stock               Int           @default(0)
  badge               String?       // "Best seller" | "New" | "Sale"
  customizable        Boolean       @default(false)
  customizationFields Json?         // [{ type, label, maxLength, required, placeholder }]
  previewTemplate     String?       // ← NEW: Cloudinary URL of clean product photo
  previewZones        Json?         // ← NEW: [{ id, type, x, y, width, ... }]
  status              ProductStatus @default(ACTIVE)
  tags                String[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  orderItems  OrderItem[]
  cartItems   CartItem[]
  wishlist    Wishlist[]
  reviews     Review[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([customizable])
  @@index([badge])
  @@index([stock])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id            Int      @id @default(autoincrement())
  cartId        Int
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int      @default(1)
  customization Json?
  createdAt     DateTime @default(now())

  @@index([cartId])
  @@index([productId])
  @@index([cartId, productId])
}

model Order {
  id                Int            @id @default(autoincrement())
  userId            Int?
  user              User?          @relation(fields: [userId], references: [id])
  items             OrderItem[]
  totalAmount       Int
  paymentStatus     PaymentStatus  @default(PENDING)
  deliveryStatus    DeliveryStatus @default(PROCESSING)
  paymentMethod     String?
  addressId         Int?
  address           Address?       @relation(fields: [addressId], references: [id])
  addressSnapshot   Json?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  couponCode        String?
  couponId          Int?
  coupon            Coupon?        @relation(fields: [couponId], references: [id])
  couponDiscount    Int?
  trackingId        String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([paymentStatus, deliveryStatus])
  @@index([razorpayOrderId])
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int
  price         Int
  customization Json?

  @@index([orderId])
  @@index([productId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Coupon {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  type       String
  value      Int
  minAmount  Int       @default(0)
  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  orders     Order[]
  createdAt  DateTime  @default(now())

  @@index([code])
  @@index([isActive])
}

model Review {
  id        Int          @id @default(autoincrement())
  userId    Int?
  user      User?        @relation(fields: [userId], references: [id])
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  name      String
  rating    Int
  comment   String
  images    String[]
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([productId])
  @@index([status])
  @@index([productId, status])
  @@index([userId])
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?
  image     String
  linkUrl   String?
  position  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([position, isActive])
}

model Setting {
  key   String @id
  value String
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String?
  entityId  Int?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  phone     String
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, otp])
  @@index([expiresAt])
}