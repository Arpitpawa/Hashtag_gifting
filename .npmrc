# lucide-react@0.383.0 (and a handful of other older deps) declare a peer
# range of react ^16/17/18 -- they run fine under React 19 in practice, this
# is just an unupdated peer-range metadata mismatch, not a real
# incompatibility. npm installs it fine locally because node_modules was
# never freshly reinstalled since the React 19 bump; Vercel always does a
# clean install and enforces peer ranges strictly by default, which fails
# the build otherwise (ERESOLVE). This restores npm's older, permissive
# resolution behavior so both environments install identically.
legacy-peer-deps=true
